#HOW TO START PROJECT:
1. npx create-expo-app@latest my-first-app
2. cd my-first-app

#RESET THE PROJECT:
npm run reset-project   #MAKE SURE YOU RUN 'cd project-name' IN TERMINAL BEFORE YOU RESET.

#WRITING IN JAVASCRIPT?
RENAME THE DEFAULT FILES INSIDE INDEX TO filename.js '.js' WILL CHANGE FROM TSX TO JS

#CHECK IF PROJECT RUNS:
npx expo start --clear

